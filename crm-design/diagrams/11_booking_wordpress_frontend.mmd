flowchart TB
    subgraph FRONT ["1. Website Search (biharcabs.com)"]
        direction LR
        VISIT(["Visitor Enters Route\nPickup, Drop, Date, Time"])
        JS["biharcabs.js\nGET /wp-json/biharcabs/v1/plans"]
        WP1["WordPress Proxy\nclass-rest.php -> CRM\nGET /api/public/plans"]
        VISIT --> JS --> WP1
    end

    subgraph LIVE_PLANS ["2. CRM Live Pricing & Availability Engine"]
        direction LR
        FUEL["Daily Fuel Sync\n(IST 1-Day Cache)"]
        DIST["Road Distance\nLocationIQ + PG Cache"]
        AVAIL["City Cab Availability\nExcludes TRIP_IN_PROGRESS\n& gap conflicts"]
        PRICE["Distance-Adjusted Fare\nper Available Package"]
        FUEL --> DIST --> AVAIL --> PRICE
    end

    subgraph BOOK_REQ ["3. Visitor Selects Plan & Submits"]
        direction LR
        SHOW["Website Plan Dropdown\nOnly Free Cabs Shown\nwith GST-Inclusive Fare"]
        SUBMIT["Visitor Confirms Plan\nPOST /wp-json/biharcabs/v1/book"]
        WP2["WordPress Proxy\nRate-Limited -> CRM\nPOST /api/public/bookings"]
        SHOW --> SUBMIT --> WP2
    end

    subgraph CONFIRM ["4. Server-Side Verification, Persistence & Dispatch"]
        direction LR
        CHK{"Cab Still Free\nin Origin City?"}
        ERR["HTTP 409\nUnavailable Notice"]
        DB[("PostgreSQL\nRecompute Fare\nInsert crm_bookings\nFULL_CASH, WORDPRESS")]
        WA["WhatsApp Dispatch\nDriver Broadcast +\nCustomer Confirmation"]
        CHK -- "No" --> ERR
        CHK -- "Yes" --> DB --> WA
    end

    FRONT --> LIVE_PLANS
    LIVE_PLANS --> BOOK_REQ
    BOOK_REQ --> CONFIRM

    classDef accent fill:#fff7ed,stroke:#ea580c,stroke-width:1.5px,color:#7c2d12
    classDef db fill:#eff6ff,stroke:#2563eb,stroke-width:1.5px,color:#1e3a8a
    classDef decision fill:#fefce8,stroke:#ca8a04,stroke-width:1.5px,color:#713f12
    classDef err fill:#fef2f2,stroke:#dc2626,stroke-width:1.5px,color:#991b1b
    classDef ok fill:#ecfdf5,stroke:#059669,stroke-width:1.5px,color:#065f46

    class VISIT,JS,WP1,FUEL,DIST,AVAIL,PRICE,SUBMIT,WP2 accent
    class DB db
    class CHK decision
    class ERR err
    class SHOW,WA ok
