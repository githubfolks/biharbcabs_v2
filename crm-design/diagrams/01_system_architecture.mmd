flowchart TB
    subgraph CHANNELS ["1. Customer, Driver & Staff Touchpoints"]
        direction LR
        WEB["biharcabs.com (WordPress)\nLive Plans & Booking Proxy\n/wp-json/biharcabs/v1/plans & /book"]
        WA["WhatsApp (Meta Cloud API)\nCustomer Booking, OTP, GST PDF\nDriver KYC, Ride Offers, Wake-up"]
        STAFF["CRM Web Dashboard\nOperator Booking, Dispatch Board,\nCatalog, Drivers, Finance & Settings"]
        WEB ~~~ WA ~~~ STAFF
    end

    subgraph CRM ["2. BiharCabs Operational CRM (Next.js 14)"]
        direction LR
        PRICE["Unified Pricing & Availability\nExcel Formula + Road Distance\nCA Tax Split + City Cab Check"]
        DISPATCH["Dispatch & Escalation Engine\nBroadcast, Plan/Return Priority,\nSLA Alerts & T-2h Wake-up (n8n)"]
        BILL["Settlement & GST Billing\nFULL_CASH, Extra KM/PHEXCHG,\nPlan/Wallet Ledger & TI PDF"]
        PRICE --> DISPATCH --> BILL
    end

    subgraph INTEGRATIONS ["3. External Integrations (All Config-Driven)"]
        direction LR
        LOC["LocationIQ API\nAutocomplete, Geocoding\n& Cached Driving Distance"]
        FUEL["Fuel Price API\nDaily IST Auto-Sync\n(1-Day Cache)"]
        RZP["Razorpay\nDriver Dues & Driver\nSubscription Plans Only"]
        LOC ~~~ FUEL ~~~ RZP
    end

    PG[("4. Native Host PostgreSQL — Single Source of Truth\ncrm_settings | crm_fuel_prices | crm_cab_types | crm_packages | crm_driver_plans\ncrm_bookings | crm_drivers & vehicles | crm_dispatch_offers | crm_route_distance_cache\ncrm_payments_ledger | crm_invoices")]

    CHANNELS --> CRM
    CRM --> INTEGRATIONS
    CRM --> PG
    INTEGRATIONS --> PG

    classDef accent fill:#fff7ed,stroke:#ea580c,stroke-width:1.5px,color:#7c2d12
    classDef db fill:#eff6ff,stroke:#2563eb,stroke-width:1.5px,color:#1e3a8a
    classDef ext fill:#fefce8,stroke:#ca8a04,stroke-width:1.5px,color:#713f12
    classDef ok fill:#ecfdf5,stroke:#059669,stroke-width:1.5px,color:#065f46

    class WEB,WA,STAFF ok
    class PRICE,DISPATCH,BILL accent
    class LOC,FUEL,RZP ext
    class PG db
