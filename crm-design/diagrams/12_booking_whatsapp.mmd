flowchart TB
    subgraph INBOUND ["1. Customer Message & State Machine"]
        direction LR
        MSG(["Customer on WhatsApp\nSends HI or Route Text"])
        WH["Meta Cloud Webhook\nPOST /api/whatsapp/webhook\nVerify HMAC & Load State"]
        COLLECT["Guided Prompts\n1. Trip Type\n2. Origin & Destination\n3. Pickup Date & Time"]
        MSG --> WH --> COLLECT
    end

    subgraph QUOTE ["2. Live Distance & Fare Quoting"]
        direction LR
        FUEL["Daily Fuel Sync\n(IST 1-Day Cache)"]
        DIST["Road Distance\nLocationIQ + PG Cache"]
        CALC["Distance-Adjusted Fare\nfor Active Packages"]
        HAS{"Packages\nFound?"}
        ESC["Notify Ops Admins\nCustom Quote Notice"]
        FUEL --> DIST --> CALC --> HAS
        HAS -- "No" --> ESC
    end

    subgraph SELECT ["3. Plan Selection & Pickup Landmark"]
        direction LR
        LIST["WA Interactive List\nPlans + GST-Incl. Fare\nBilled KM & Extra Rates"]
        PICK["Customer Taps Plan\n(sel_pkg_ID)\nConfirm Fare Summary"]
        LAND["Customer Replies\nExact Pickup Landmark\n& Address"]
        LIST --> PICK --> LAND
    end

    subgraph BOOKING ["4. Booking Creation & Driver Dispatch"]
        direction LR
        DB[("PostgreSQL\nRe-price via Helper\nUpsert Customer\nInsert crm_bookings\nFULL_CASH, WHATSAPP")]
        DISP["Broadcast Ride Offers\nto Eligible Drivers +\nCustomer WA Summary"]
        OTP(["Driver Accepts ->\nCustomer Receives Driver\nDetails & 4-Digit OTP"])
        DB --> DISP --> OTP
    end

    INBOUND --> QUOTE
    QUOTE --> SELECT
    SELECT --> BOOKING

    classDef accent fill:#fff7ed,stroke:#ea580c,stroke-width:1.5px,color:#7c2d12
    classDef db fill:#eff6ff,stroke:#2563eb,stroke-width:1.5px,color:#1e3a8a
    classDef decision fill:#fefce8,stroke:#ca8a04,stroke-width:1.5px,color:#713f12
    classDef err fill:#fef2f2,stroke:#dc2626,stroke-width:1.5px,color:#991b1b
    classDef ok fill:#ecfdf5,stroke:#059669,stroke-width:1.5px,color:#065f46

    class MSG,WH,COLLECT,FUEL,DIST,CALC,LIST,PICK,LAND,DISP accent
    class DB db
    class HAS decision
    class ESC err
    class OTP ok
