docker/db-init/01-biharcabs-dump.sql

# ==============================================================================
# WordPress Core, Cache, Uploads & 3rd-Party Plugins (public_html/)
# Keep only custom theme (biharcabs) and custom plugin (biharcabs-growth-engine)
# ==============================================================================
public_html/wp-admin/
public_html/wp-includes/
public_html/index.php
public_html/license.txt
public_html/readme.html
public_html/default.php
public_html/llms.txt
public_html/xmlrpc.php
public_html/wp-*.php

# WordPress wp-content runtime & cache directories
**/wp-content/uploads/
**/wp-content/cache/
**/wp-content/litespeed/
**/wp-content/upgrade/
**/wp-content/upgrade-temp-backup/
**/wp-content/mu-plugins/
**/wp-content/advanced-cache.php
**/wp-content/object-cache.php
**/wp-content/db.php
**/wp-content/debug.log

# Ignore 3rd-party plugins, track only biharcabs-growth-engine
public_html/wp-content/plugins/*
!public_html/wp-content/plugins/biharcabs-growth-engine/

# Ignore default/3rd-party themes, track only biharcabs custom theme
public_html/wp-content/themes/*
!public_html/wp-content/themes/biharcabs/

