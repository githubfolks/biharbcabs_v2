# Native PostgreSQL on Host OS (Local Mac / VPS)
DATABASE_URL=postgresql://postgres:password@localhost:5432/biharcabs_crm
PGHOST=localhost
PGPORT=5432
PGDATABASE=biharcabs_crm
PGUSER=postgres
PGPASSWORD=

# BiharCabs Live Pricing Bridge URL
WP_API_BASE_URL=http://localhost:8080
PORT=3001

# Meta App Secret: required. Webhook events without a valid X-Hub-Signature-256 are rejected.
META_APP_SECRET=

# Scheduler secret: n8n sends "Authorization: Bearer <CRON_SECRET>" to /api/dispatch/cron*. Required; calls are refused until set.
CRON_SECRET=
