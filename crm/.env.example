# Native PostgreSQL on Host OS (Local Mac / VPS)
DATABASE_URL=postgresql://postgres:password@localhost:5432/biharcabs_crm
PGHOST=localhost
PGPORT=5432
PGDATABASE=biharcabs_crm
PGUSER=postgres
PGPASSWORD=

# BiharCabs Live Pricing Bridge URL
WP_API_BASE_URL=http://localhost:8080
PORT=3001

# Meta App Secret: required. Webhook events without a valid X-Hub-Signature-256 are rejected.
META_APP_SECRET=

# Scheduler secret: n8n sends "Authorization: Bearer <CRON_SECRET>" to /api/dispatch/cron*. Required; calls are refused until set.
CRON_SECRET=

# Razorpay (customer advance via Payment Links). Use test-mode keys outside production.
# RAZORPAY_WEBHOOK_SECRET is the secret set on the webhook (Dashboard > Webhooks) for
# https://<crm-host>/api/payments/razorpay/webhook with events payment_link.paid,
# payment_link.expired, payment_link.cancelled, refund.processed and refund.failed. Until it is set,
# webhook calls get 503.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Per-IP sign-in limit (optional). Name the header your reverse proxy sets to the real client IP,
# e.g. x-real-ip (nginx: proxy_set_header X-Real-IP $remote_addr;) or x-forwarded-for (the last entry
# is used). Leave empty when the CRM is reached directly: callers could then forge the header, so only
# the per-email limit applies.
CLIENT_IP_HEADER=
