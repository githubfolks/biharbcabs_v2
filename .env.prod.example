# ==============================================================================
# BiharCabs Server Environment (.env) — Staging / Production on Oracle Cloud
# Copy to root `.env` on the server (chmod 600 .env). NEVER commit `.env` to git.
# ==============================================================================

# --- WordPress & MariaDB (Docker) ---
WP_DB_NAME=biharcabs_wp
WP_DB_USER=biharcabs_wp
# Generate with: openssl rand -hex 24
WP_DB_PASSWORD=
WP_DB_ROOT_PASSWORD=
# Staging first, then switch to https://biharcabs.com at cutover
WP_HOME=https://staging.biharcabs.com
WP_SITEURL=https://staging.biharcabs.com
# staging | production
WP_ENVIRONMENT_TYPE=staging

# --- CRM Native PostgreSQL Role (host OS PostgreSQL 16, port 5432) ---
# Must be URL-safe, >= 24 chars. Generate with: openssl rand -hex 24
CRM_DB_PASSWORD=

# --- CRM Scheduler & Security ---
# Generate with: openssl rand -hex 32 (put exact same value in n8n Header Auth credential)
CRON_SECRET=
# Reverse proxy real IP header set by Nginx (proxy_set_header X-Real-IP $remote_addr;)
CLIENT_IP_HEADER=x-real-ip

# --- Meta WhatsApp Cloud API ---
# Required for webhook X-Hub-Signature-256 verification
META_APP_SECRET=

# --- Razorpay (Use TEST keys in staging, LIVE keys in production) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Optional LocationIQ ---
LOCATIONIQ_API_KEY=

# --- n8n (Docker, backed by native host PostgreSQL database `n8n`) ---
# Generate with: openssl rand -hex 24
N8N_DB_PASSWORD=
# Generate with: openssl rand -hex 32 — BACK THIS UP SECURELY!
N8N_ENCRYPTION_KEY=

# --- Backups (host directory containing last_backup.json, mounted read-only into CRM) ---
BACKUP_STATUS_DIR=/var/backups/biharcabs
# Optional: encrypt nightly backups with AES-256-CBC PBKDF2
BACKUP_PASSPHRASE=
# Optional: S3 / OCI Object Storage S3-compatible bucket URI
BACKUP_S3_URI=
